            transition: transform 0.08s ease, border-color 0.15s ease;
            touch-action: manipulation;
        }
        .action-btn:active {
            transform: scale(0.91);
            border-color: #38bdf8;
        }

        /* 2K Curved Shot Meter SVG Overlay */
        #shot-meter-wrap {
            pointer-events: none;
            transition: opacity 0.12s ease;
        }
    </style>
