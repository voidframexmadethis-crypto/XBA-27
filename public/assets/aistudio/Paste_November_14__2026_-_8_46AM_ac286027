function updateJoystick(e) {
    const rect = joyZone.getBoundingClientRect();
    const cx = rect.left + rect.width / 2;
    const cy = rect.top + rect.height / 2;
    const maxR = rect.width * 0.36;
    let dx = e.clientX - cx;
    let dy = e.clientY - cy;
    const dist = Math.hypot(dx, dy);
    if (dist > maxR) {
        dx = (dx / dist) * maxR;
        dy = (dy / dist) * maxR;
    }
    joyKnob.style.transform = `translate(${dx}px, ${dy}px)`;
    joyInput.x = dx / maxR;
    joyInput.y = dy / maxR;
}

// --- 11. BASKETBALL MECHANICS: SHOT METER, DUNKS, CROSSOVERS, PASSING, STEALS ---
function handleActionPress() {
    const cp = gameState.controlledPlayer;
    if (!cp) return;

    if (gameState.ballState === 'held' && gameState.ballHandler === cp) {
        // Begin 2K Shot Meter Charge
        const targetHoopX = cp.team === 'home' ? HOOP_X : -HOOP_X;
        const distToRim = Math.hypot(targetHoopX - cp.pos.x, 0 - cp.pos.z);

        // Check nearest defender contest distance
        let minDefDist = 99;
        gameState.players.forEach(d => {
            if (d.active && d.team !== cp.team && d.stunTimer <= 0) {
                const dd = d.pos.distanceTo(cp.pos);
                if (dd < minDefDist) minDefDist = dd;
            }
        });

        // Adjust green window based on distance & defender contest
        const baseWindow = distToRim < 3.6 ? 0.14 : (distToRim < 7.3 ? 0.115 : 0.092);
        const contestPenalty = minDefDist < 1.8 ? (1.8 - minDefDist) * 0.025 : 0;
        gameState.greenWindowWidth = Math.max(0.045, baseWindow - contestPenalty);
        gameState.greenWindowCenter = 0.76;

        gameState.isChargingShot = true;
        gameState.shotCharge = 0.05;
        cp.isJumping = true;
        cp.jumpVel = distToRim < 3.4 ? 4.4 : 3.4;
    } else {
        // On Defense or Loose Ball: Jump for Block / Rebound
        handleStealOrBlock();
    }
}

function handleActionRelease() {
    if (!gameState.isChargingShot) return;
    gameState.isChargingShot = false;
    document.getElementById('shot-meter-wrap').style.opacity = '0';

    const cp = gameState.controlledPlayer;
    if (gameState.ballState === 'held' && gameState.ballHandler === cp) {
        launchShot(cp, gameState.shotCharge);
    }
}

function launchShot(shooter, timingValue) {
    const targetHoop = hoops.find(h => h.side === (shooter.team === 'home' ? 1 : -1));
    const distToRim = Math.hypot(targetHoop.pos.x - shooter.pos.x, targetHoop.pos.z - shooter.pos.z);
    const isThree = distToRim >= 7.24; // NBA 23.75ft arc

    // Evaluate timing accuracy
    const diff = Math.abs(timingValue - gameState.greenWindowCenter);
    const isGreen = diff <= gameState.greenWindowWidth * 0.55;

    // Calculate Defender Contest %
    let contestPct = 0;
    gameState.players.forEach(d => {
        if (d.active && d.team !== shooter.team && d.stunTimer <= 0) {
            const dd = d.pos.distanceTo(shooter.pos);
            if (dd < 2.3) {
                const c = Math.round(((2.3 - dd) / 2.3) * (d.isJumping ? 88 : 54));
                if (c > contestPct) contestPct = c;
            }
        }
    });

    // Check if Driving Dunk!
    const isDunk = distToRim < 3.25 && shooter.vel.length() > 2.2;

    let makeProb = 0.68 - (distToRim * 0.025) - (contestPct * 0.0045);
    if (isDunk) makeProb = 0.88 - (contestPct * 0.003);
    const willMake = isGreen || (Math.random() < Math.max(0.12, makeProb));

    if (isGreen) {
        sfx.playGreenRelease();
        gameState.slowMoTimer = 0.55;
        triggerCallout('GREEN LIGHT!', 'text-emerald-400', isThree ? '3PT PERFECT RELEASE' : 'EXCELLENT TIMING');
    } else if (isDunk && willMake) {
        triggerCallout(contestPct > 35 ? 'POSTERIZER DUNK!' : 'SLAM DUNK!', 'text-amber-400', contestPct > 35 ? `CONTACT ${contestPct}%` : '2K HIGHLIGHT');
    } else if (shooter.team === 'home') {
        const timingLabel = timingValue < gameState.greenWindowCenter - 0.06 ? 'SLIGHTLY EARLY' :
                            (timingValue > gameState.greenWindowCenter + 0.06 ? 'SLIGHTLY LATE' : 'GOOD RELEASE');
        triggerCallout(timingLabel, 'text-sky-300', contestPct > 12 ? `${contestPct}% CONTESTED` : 'WIDE OPEN');
    }

    if (isDunk) {
        shooter.isDunking = true;
        shooter.isJumping = true;
        shooter.dunkTarget.set(targetHoop.pos.x - targetHoop.side * 0.35, 0, 0);
        shooter.jumpVel = 4.6;
        gameState.ballState = 'shot';
        gameState.ballHandler = null;
        gameState.shooter = shooter;
        gameState.shotStartPos.copy(shooter.pos).add(new THREE.Vector3(0, 2.1, 0));
        gameState.shotTargetPos.copy(targetHoop.pos);
        gameState.shotProgress = 0;
        gameState.shotDuration = 0.52;
        gameState.shotArcHeight = 3.55;
        gameState.shotIsThree = false;
        gameState.shotIsGreen = isGreen;
        gameState.shotWillMake = willMake;
        gameState.shotIsDunk = true;
        return;
    }

    // Standard Jump Shot Trajectory
    gameState.ballState = 'shot';
    gameState.ballHandler = null;
    gameState.shooter = shooter;
    gameState.shotStartPos.set(shooter.pos.x, shooter.pos.y + shooter.jumpY + 2.05, shooter.pos.z);

    if (willMake) {
        gameState.shotTargetPos.copy(targetHoop.pos);
    } else {
        // Miss slightly off the rim
        const angle = Math.random() * Math.PI * 2;
        gameState.shotTargetPos.set(
            targetHoop.pos.x + Math.cos(angle) * 0.26,
            targetHoop.pos.y,
            targetHoop.pos.z + Math.sin(angle) * 0.26
        );
    }

    gameState.shotProgress = 0;
    gameState.shotDuration = Math.min(1.25, Math.max(0.68, distToRim * 0.115));
    gameState.shotArcHeight = Math.max(3.9, 3.6 + distToRim * 0.24);
    gameState.shotIsThree = isThree;
    gameState.shotIsGreen = isGreen;
    gameState.shotWillMake = willMake;
    gameState.shotIsDunk = false;
}

function handleCrossover() {
    const cp = gameState.controlledPlayer;
    if (!cp || gameState.ballState !== 'held' || gameState.ballHandler !== cp) return;
    if (cp.crossoverTimer > 0) return;

    cp.crossoverTimer = 0.42;
    cp.dribbleHand *= -1;
    sfx.playSqueak();

    // Lateral burst
    const lateral = new THREE.Vector3(-Math.sin(cp.facing), 0, Math.cos(cp.facing)).multiplyScalar(cp.dribbleHand * 5.2);
    cp.vel.add(lateral);

    // Check if nearby defender gets ANKLE-BROKEN!
    gameState.players.forEach(d => {
        if (d.active && d.team !== cp.team && d.pos.distanceTo(cp.pos) < 2.2) {
            if (Math.random() < 0.48) {
                d.stunTimer = 1.45;
                sfx.playCrowdRoar(0.75);
                gameState.crowdHype = Math.min(1, gameState.crowdHype + 0.35);
                triggerCallout('ANKLE BREAKER!', 'text-purple-400', `${d.name} DROPPED!`);
            }
        }
    });
}

function handlePassOrSteal() {
    const cp = gameState.controlledPlayer;
    if (!cp) return;

    if (gameState.ballState === 'held' && gameState.ballHandler === cp) {
        // Find best open teammate
        const teammates = gameState.players.filter(p => p.active && p.team === cp.team && p !== cp);
        if (teammates.length === 0) return;

        let bestMate = teammates[0];
        let bestScore = -999;
        const targetHoopX = cp.team === 'home' ? HOOP_X : -HOOP_X;

        teammates.forEach(m => {
            const distToHoop = Math.abs(targetHoopX - m.pos.x);
            const passDist = m.pos.distanceTo(cp.pos);
            const score = -distToHoop * 1.2 - passDist * 0.25 + (Math.random() * 2);
            if (score > bestScore) {
                bestScore = score;
                bestMate = m;
            }
        });

        gameState.ballState = 'pass';
        gameState.ballHandler = null;
        gameState.passTarget = bestMate;
        gameState.shotStartPos.copy(ballMesh.position);
        gameState.shotProgress = 0;
        gameState.shotDuration = Math.max(0.24, cp.pos.distanceTo(bestMate.pos) * 0.045);

        if (bestMate.team === 'home') {
            gameState.controlledPlayer = bestMate;
            updateHudLabels();
        }
    } else {
        handleStealOrBlock();
    }
}

function handleStealOrBlock() {
    const cp = gameState.controlledPlayer;
    if (!cp || cp.stealCooldown > 0) return;
    cp.stealCooldown = 0.55;

    // Switch controlled player to nearest defender to ball if on defense
    if (!gameState.ballHandler || gameState.ballHandler.team !== 'home') {
        let nearest = cp;
        let minDist = 999;
        gameState.players.forEach(p => {
            if (p.active && p.team === 'home') {
                const d = p.pos.distanceTo(ballMesh.position);
                if (d < minDist) {
                    minDist = d;
                    nearest = p;
                }
            }
        });
        if (nearest !== cp) {
            gameState.controlledPlayer = nearest;
            updateHudLabels();
        }
    }

    const activeDef = gameState.controlledPlayer;
    if (gameState.ballState === 'shot' || ballMesh.position.y > 2.2) {
        // Jump Block / Rebound Attempt
        if (!activeDef.isJumping) {
            activeDef.isJumping = true;
            activeDef.jumpVel = 4.3;
        }
    } else if (gameState.ballState === 'held' && gameState.ballHandler && gameState.ballHandler.team !== activeDef.team) {
        // Reach-in Steal Attempt
        const handler = gameState.ballHandler;
        if (activeDef.pos.distanceTo(handler.pos) < 1.65) {
            if (Math.random() < 0.34) {
                gameState.ballHandler = activeDef;
                sfx.playSqueak();
                sfx.playCrowdRoar(0.6);
                triggerCallout('STEAL!', 'text-sky-400', `TURNOVER FORCED BY ${activeDef.name}`);
                updateHudLabels();
            }
        }
    }
}

// --- 12. SMART 5v5 AI & PLAYER KINEMATICS UPDATE ---
function updatePlayersAndAI(dt) {
    const offenseTeam = gameState.ballHandler ? gameState.ballHandler.team :
                        (gameState.shooter ? gameState.shooter.team : 'home');

    gameState.players.forEach(p => {
        if (!p.active) return;

        p.selectRing.material.opacity = (p === gameState.controlledPlayer) ? 0.85 : 0.0;
        if (p.crossoverTimer > 0) p.crossoverTimer -= dt;
        if (p.stealCooldown > 0) p.stealCooldown -= dt;

        // Ankle-breaker stunned state
        if (p.stunTimer > 0) {
            p.stunTimer -= dt;
            p.hips.rotation.z = Math.sin(p.stunTimer * 12) * 0.38;
            p.hips.position.y = 0.78;
            return;
        } else {
            p.hips.rotation.z *= 0.85;
        }

        const moveVec = new THREE.Vector3();
        let isSprinting = false;

        if (p === gameState.controlledPlayer && !p.isDunking) {
            // Human Input (mapped to camera orientation)
            let ix = 0, iz = 0;
            if (keys['KeyW'] || keys['ArrowUp']) iz -= 1;
            if (keys['KeyS'] || keys['ArrowDown']) iz += 1;
            if (keys['KeyA'] || keys['ArrowLeft']) ix -= 1;
            if (keys['KeyD'] || keys['ArrowRight']) ix += 1;

            if (joyInput.active) {
                ix += joyInput.x;
                iz += joyInput.y;
            }

            if (gameState.camMode === 0) {
                // 2K Classic Camera looks along +X (toward right hoop)
                moveVec.set(-iz, 0, ix);
            } else {
                // Broadcast TV Camera looks along -Z
                moveVec.set(ix, 0, iz);
            }

            isSprinting = (keys['ShiftLeft'] || keys['ShiftRight'] || touchSprint) && p.stamina > 5;
        } else if (!p.isDunking) {
            // Smart 5v5 AI Logic
            const targetHoopX = p.team === 'home' ? HOOP_X : -HOOP_X;
            const ownHoopX = -targetHoopX;
            const dir = p.team === 'home' ? 1 : -1;

            if (gameState.ballState === 'loose' || gameState.ballState === 'shot') {
                // Crash the boards for rebound or chase loose ball
                const target = gameState.ballState === 'loose' ? ballMesh.position :
                               new THREE.Vector3(targetHoopX - dir * 1.6, 0, (p.index - 2) * 1.3);
                moveVec.subVectors(target, p.pos);
                moveVec.y = 0;
                isSprinting = true;
            } else if (p === gameState.ballHandler) {
                // AI Ball Handler drives or pulls up for 3PT/Mid-range
                const goal = new THREE.Vector3(targetHoopX - dir * 4.8, 0, Math.sin(performance.now() * 0.0012 + p.index) * 3.8);
                moveVec.subVectors(goal, p.pos);
                moveVec.y = 0;

                const distToRim = Math.hypot(targetHoopX - p.pos.x, p.pos.z);
                if (distToRim < 7.8 && Math.random() < dt * 0.75 && !p.isJumping) {
                    p.isJumping = true;
                    p.jumpVel = 3.5;
                    const aiTiming = 0.66 + Math.random() * 0.18;
                    setTimeout(() => {
                        if (gameState.ballHandler === p && gameState.ballState === 'held') {
                            launchShot(p, aiTiming);
                        }
                    }, 260);
                }
            } else if (p.team === offenseTeam) {
                // Off-Ball Floor Spacing & Cuts (5-Out / Motion Offense)
                const spotAngles = [-0.75, -0.35, 0.35, 0.75, 0.0];
                const ang = spotAngles[p.index % 5];
                const radius = p.index === 4 ? 2.6 : 7.6;
                const spotX = targetHoopX - dir * Math.cos(ang) * radius;
                const spotZ = Math.sin(ang) * radius * 1.1;
                const spot = new THREE.Vector3(spotX, 0, spotZ);
                moveVec.subVectors(spot, p.pos);
                moveVec.y = 0;
            } else {
                // Man-to-Man Defense (Stay between assigned man and own hoop)
                const opponent = gameState.players.find(opp => opp.active && opp.team !== p.team && opp.index === p.index) || gameState.ballHandler;
                if (opponent) {
                    const guardPos = new THREE.Vector3().lerpVectors(opponent.pos, new THREE.Vector3(ownHoopX, 0, 0), 0.24);
                    moveVec.subVectors(guardPos, p.pos);
                    moveVec.y = 0;
                    if (moveVec.length() > 2.5) isSprinting = true;
                }
            }
        }

        // Stamina update
        if (isSprinting && moveVec.lengthSq() > 0.01) {
            p.stamina = Math.max(0, p.stamina - dt * 22);
        } else {
            p.stamina = Math.min(100, p.stamina + dt * 16);
        }
        if (p === gameState.controlledPlayer) {
            document.getElementById('stamina-bar').style.width = `${p.stamina}%`;
        }

        // Apply Horizontal Movement
        if (!p.isDunking) {
            if (moveVec.length() > 0.08) {
                moveVec.normalize();
                const speed = (isSprinting ? 6.9 : 4.7) * (p === gameState.ballHandler ? 0.94 : 1.0);
                p.vel.x = THREE.MathUtils.lerp(p.vel.x, moveVec.x * speed, dt * 11);
                p.vel.z = THREE.MathUtils.lerp(p.vel.z, moveVec.z * speed, dt * 11);
            } else {
                p.vel.x *= Math.pow(0.05, dt);
                p.vel.z *= Math.pow(0.05, dt);
            }
            p.pos.addScaledVector(p.vel, dt);
        } else {
            // Dunk Flight Path toward Rim
            p.pos.lerp(p.dunkTarget, dt * 7.5);
        }

        // Keep Players In-Bounds on Court
        p.pos.x = THREE.MathUtils.clamp(p.pos.x, -COURT_LENGTH / 2 + 0.5, COURT_LENGTH / 2 - 0.5);
        p.pos.z = THREE.MathUtils.clamp(p.pos.z, -COURT_WIDTH / 2 + 0.5, COURT_WIDTH / 2 - 0.5);

        // Jump & Gravity Kinematics
        if (p.isJumping || p.jumpY > 0) {
            p.jumpY += p.jumpVel * dt;
            p.jumpVel -= 11.8 * dt;
            if (p.jumpY <= 0) {
                p.jumpY = 0;
                p.jumpVel = 0;
                p.isJumping = false;
                p.isDunking = false;
            }
        }

        // Player Orientation (Face movement or face hoop when shooting)
        if (p === gameState.ballHandler && (gameState.isChargingShot || p.isJumping)) {
            const hoopX = p.team === 'home' ? HOOP_X : -HOOP_X;
            p.facing = Math.atan2(hoopX - p.pos.x, 0 - p.pos.z);
        } else if (p.vel.lengthSq() > 0.25) {
            const targetYaw = Math.atan2(p.vel.x, p.vel.z);
            let diff = targetYaw - p.facing;
            while (diff > Math.PI) diff -= Math.PI * 2;
            while (diff < -Math.PI) diff += Math.PI * 2;
            p.facing += diff * Math.min(1, dt * 12);
        }

        p.root.position.set(p.pos.x, p.jumpY, p.pos.z);
        p.root.rotation.y = p.facing;

        // Procedural Skeletal Limb Animation (Running Stride, Dribbling, Jump Shot Release)
        const speedHoriz = Math.hypot(p.vel.x, p.vel.z);
        if (p.isJumping) {
            // Jump Shot / Dunk Pose
            p.leftLeg.root.rotation.x = 0.28;
            p.leftLeg.joint.rotation.x = -0.45;
            p.rightLeg.root.rotation.x = -0.15;
            p.rightLeg.joint.rotation.x = -0.25;

            if (p === gameState.ballHandler || p.isDunking || (gameState.shooter === p && gameState.shotProgress < 0.35)) {
                p.rightArm.root.rotation.x = -2.65;
                p.rightArm.joint.rotation.x = -0.35;
                p.leftArm.root.rotation.x = -2.35;
                p.leftArm.joint.rotation.x = -0.5;
            } else {
                // Defensive Contest Arms Up
                p.rightArm.root.rotation.x = -2.85;
                p.leftArm.root.rotation.x = -2.85;
            }
        } else if (speedHoriz > 0.35) {
            // Dynamic Running Stride Cycle
            p.stridePhase += dt * speedHoriz * 2.45;
            const swing = Math.sin(p.stridePhase) * 0.72;
            p.leftLeg.root.rotation.x = swing;
            p.rightLeg.root.rotation.x = -swing;
            p.leftLeg.joint.rotation.x = Math.max(0, -swing) * 0.85;
            p.rightLeg.joint.rotation.x = Math.max(0, swing) * 0.85;
            p.hips.position.y = 1.0 + Math.abs(Math.cos(p.stridePhase)) * 0.05;

            if (p === gameState.ballHandler) {
                // Dribbling Arm Pumping
                p.dribblePhase += dt * 9.5;
                const dWave = Math.sin(p.dribblePhase);
                const activeArm = p.dribbleHand === 1 ? p.rightArm : p.leftArm;
                const offArm = p.dribbleHand === 1 ? p.leftArm : p.rightArm;
                activeArm.root.rotation.x = -0.45 + dWave * 0.38;
                activeArm.joint.rotation.x = -0.75 - dWave * 0.35;
                offArm.root.rotation.x = swing * 0.5 - 0.3;
                offArm.joint.rotation.x = -0.4;
            } else {
                p.leftArm.root.rotation.x = -swing * 0.65;
                p.rightArm.root.rotation.x = swing * 0.65;
                p.leftArm.joint.rotation.x = -0.45;
                p.rightArm.joint.rotation.x = -0.45;
            }
        } else {
            // Athletic Stance / Idle Dribble
            p.hips.position.y = 0.99;
            p.leftLeg.root.rotation.x = -0.14;
            p.leftLeg.joint.rotation.x = 0.28;
            p.rightLeg.root.rotation.x = 0.14;
            p.rightLeg.joint.rotation.x = 0.28;

            if (p === gameState.ballHandler) {
                p.dribblePhase += dt * 7.5;
                const dWave = Math.sin(p.dribblePhase);
                const activeArm = p.dribbleHand === 1 ? p.rightArm : p.leftArm;
                activeArm.root.rotation.x = -0.42 + dWave * 0.35;
                activeArm.joint.rotation.x = -0.72 - dWave * 0.32;
            } else {
                // Defensive Wide Stance
                p.leftArm.root.rotation.z = 0.45;
                p.rightArm.root.rotation.z = -0.45;
                p.leftArm.root.rotation.x = -0.35;
                p.rightArm.root.rotation.x = -0.35;
            }
        }
    });
}

// --- 13. BASKETBALL PHYSICS, SWISH NETS & SCORING ---
function updateBallAndScoring(dt) {
    if (gameState.ballState === 'held' && gameState.ballHandler) {
        const h = gameState.ballHandler;
        const forward = new THREE.Vector3(Math.sin(h.facing), 0, Math.cos(h.facing));
        const right = new THREE.Vector3(Math.cos(h.facing), 0, -Math.sin(h.facing)).multiplyScalar(h.dribbleHand);

        if (gameState.isChargingShot || h.isJumping) {
            // Set-point above shooter's head
            ballMesh.position.set(
                h.pos.x + forward.x * 0.24,
                h.jumpY + 2.08,
                h.pos.z + forward.z * 0.24
            );
        } else {
            // Realistic Dribble Bounce to Hardwood
            const bounceSin = Math.abs(Math.sin(h.dribblePhase));
            const prevBounce = Math.abs(Math.sin(h.dribblePhase - dt * 8.5));
            if (bounceSin < 0.14 && prevBounce >= 0.14) {
                sfx.playBounce(0.75);
            }
            const ballY = 0.13 + bounceSin * 0.92;
            ballMesh.position.set(
                h.pos.x + forward.x * 0.42 + right.x * 0.26,
                ballY,
                h.pos.z + forward.z * 0.42 + right.z * 0.26
            );
            ballMesh.rotation.x += dt * 10;
        }
    } else if (gameState.ballState === 'pass' && gameState.passTarget) {
        gameState.shotProgress += dt / gameState.shotDuration;
        const t = Math.min(1, gameState.shotProgress);
        const dest = new THREE.Vector3(gameState.passTarget.pos.x, 1.15, gameState.passTarget.pos.z);
        ballMesh.position.lerpVectors(gameState.shotStartPos, dest, t);
        ballMesh.position.y += Math.sin(t * Math.PI) * 0.45;

        if (t >= 1) {
            gameState.ballHandler = gameState.passTarget;
            gameState.ballState = 'held';
            sfx.playBounce(0.45);
        }
    } else if (gameState.ballState === 'shot') {
        gameState.shotProgress += dt / gameState.shotDuration;
        const t = Math.min(1, gameState.shotProgress);

        ballMesh.position.lerpVectors(gameState.shotStartPos, gameState.shotTargetPos, t);
        // Parabolic arc peaking at shotArcHeight
        const linearY = THREE.MathUtils.lerp(gameState.shotStartPos.y, gameState.shotTargetPos.y, t);
        const arcOffset = 4 * (gameState.shotArcHeight - (gameState.shotStartPos.y + gameState.shotTargetPos.y) * 0.5) * t * (1 - t);
        ballMesh.position.y = linearY + Math.max(0, arcOffset);
        ballMesh.rotation.x -= dt * 16; // Backspin!

        if (t >= 1) {
            const targetHoop = hoops.find(h => h.side === (gameState.shooter.team === 'home' ? 1 : -1));
            if (gameState.shotWillMake) {
                // MADE BASKET!
                const pts = gameState.shotIsThree ? 3 : 2;
                if (gameState.shooter.team === 'home') {
                    gameState.homeScore += pts;
                    document.getElementById('score-home').textContent = gameState.homeScore;
                } else {
                    gameState.awayScore += pts;
                    document.getElementById('score-away').textContent = gameState.awayScore;
                }

                sfx.playSwish();
                sfx.playCrowdRoar(gameState.shotIsGreen ? 1.2 : 0.85);
                gameState.crowdHype = 1.0;
                targetHoop.netSwishTime = 0.75;
                targetHoop.ledFlashTimer = 1.4;
                if (gameState.shotIsDunk) targetHoop.rimBend = 0.25;

                // Camera Flash Strobe in crowd
                flashLight.position.set((Math.random() - 0.5) * 24, 6, -13);
                flashLight.intensity = 3.5;

                // Ball drops through net & opposing team inbounds
                gameState.ballState = 'loose';
                gameState.ballVel.set(-targetHoop.side * 0.6, -2.6, 0);
                const nextOffense = gameState.shooter.team === 'home' ? 'away' : 'home';
                setTimeout(() => {
                    resetPositionsForPossession(nextOffense, false);
                }, 1150);
            } else {
                // RIM CLANK REBOUND!
                sfx.playRimClank();
                targetHoop.rimBend = 0.14;
                gameState.ballState = 'loose';
                gameState.ballVel.set(
                    -targetHoop.side * (2.2 + Math.random() * 2.2),
                    3.2 + Math.random() * 1.5,
                    (Math.random() - 0.5) * 4.2
                );
            }
        }
    } else if (gameState.ballState === 'loose') {
        ballMesh.position.addScaledVector(gameState.ballVel, dt);
        gameState.ballVel.y -= 9.81 * dt;

        // Hardwood bounce
        if (ballMesh.position.y <= 0.125) {
            ballMesh.position.y = 0.125;
            if (Math.abs(gameState.ballVel.y) > 1.1) {
                sfx.playBounce(Math.abs(gameState.ballVel.y) / 6);
                gameState.ballVel.y = -gameState.ballVel.y * 0.68;
                gameState.ballVel.x *= 0.85;
                gameState.ballVel.z *= 0.85;
            } else {
                gameState.ballVel.y = 0;
            }
        }

        // Check Rebound / Loose Ball Pickup
        if (ballMesh.position.y < 2.4) {
            for (const p of gameState.players) {
                if (!p.active) continue;
                const d = Math.hypot(p.pos.x - ballMesh.position.x, p.pos.z - ballMesh.position.z);
                if (d < 0.85 && ballMesh.position.y <= p.jumpY + 2.15) {
                    gameState.ballHandler = p;
                    gameState.ballState = 'held';
                    gameState.shotClock = 24;
                    if (p.team === 'home') {
                        gameState.controlledPlayer = p;
                        triggerCallout('REBOUND!', 'text-sky-400', `${p.name} SECURES THE BOARD`);
                    }
                    updateHudLabels();
                    break;
                }
            }
        }
    }
}

// --- 14. UPDATE 2K SHOT METER OVERLAY, HOOP NETS, CROWD & JUMBOTRON ---
function updateShotMeterUI(dt) {
    const meterWrap = document.getElementById('shot-meter-wrap');
    if (!gameState.isChargingShot || !gameState.controlledPlayer) {
        meterWrap.style.opacity = '0';
        return;
    }

    gameState.shotCharge = Math.min(1.0, gameState.shotCharge + dt * 1.18);
    if (gameState.shotCharge >= 1.0) {
        handleActionRelease();
        return;
    }

    // Project 3D player shoulder position to 2D screen coordinates
    const worldPos = gameState.controlledPlayer.pos.clone().add(new THREE.Vector3(0, 2.25, 0));
    worldPos.project(camera);
    const sx = (worldPos.x * 0.5 + 0.5) * window.innerWidth + 46;
    const sy = (-worldPos.y * 0.5 + 0.5) * window.innerHeight;

    meterWrap.style.left = `${sx}px`;
    meterWrap.style.top = `${sy}px`;
    meterWrap.style.opacity = '1';

    const arcLen = 115;
    const fillArc = document.getElementById('meter-fill-arc');
    fillArc.style.strokeDashoffset = arcLen * (1 - gameState.shotCharge);

    const inGreen = Math.abs(gameState.shotCharge - gameState.greenWindowCenter) <= gameState.greenWindowWidth * 0.55;
    fillArc.setAttribute('stroke', inGreen ? '#10b981' : '#38bdf8');
    const tag = document.getElementById('meter-quality-tag');
    tag.textContent = inGreen ? 'GREEN!' : 'RELEASE';
    tag.className = `text-center font-sports text-sm tracking-wider uppercase font-bold -mt-3 ${inGreen ? 'text-emerald-400' : 'text-sky-300'}`;
}

function updateArenaDetails(dt, elapsed) {
    // 1. Hoop Net Swish Ripple, Rim Breakaway Spring & Shot Clock LEDs
    hoops.forEach(h => {
        if (h.netSwishTime > 0) {
            h.netSwishTime -= dt;
            const posAttr = h.netGeo.attributes.position;
            const wave = Math.sin((0.75 - h.netSwishTime) * 18) * (h.netSwishTime * 0.14);
            for (let i = 0; i < posAttr.count; i++) {
                const bx = h.netBasePos[i * 3];
                const by = h.netBasePos[i * 3 + 1];
                const bz = h.netBasePos[i * 3 + 2];
                const factor = Math.max(0, (0.22 - by) / 0.44);
                posAttr.setXYZ(i, bx * (1 + wave * factor * 2.5), by + Math.abs(wave) * 0.18 * factor, bz * (1 + wave * factor * 2.5));
            }
            posAttr.needsUpdate = true;
        }

        if (h.rimBend > 0.001) {
            h.rimMesh.rotation.z = h.side * h.rimBend;
            h.rimBend *= Math.pow(0.04, dt);
        } else {
            h.rimMesh.rotation.z = 0;
        }

        if (h.ledFlashTimer > 0) {
            h.ledFlashTimer -= dt;
            h.ledMat.emissiveIntensity = 2.4;
        } else {
            h.ledMat.emissiveIntensity = gameState.shotClock <= 5 ? 1.8 : 0.25;
        }

        // Update 24-second Shot Clock Canvas on Backboard
        const cCtx = h.clockCtx;
        cCtx.fillStyle = '#050811';
        cCtx.fillRect(0, 0, 128, 128);
        cCtx.fillStyle = gameState.shotClock <= 5 ? '#ef4444' : '#f59e0b';
        cCtx.font = '900 76px Teko, sans-serif';
        cCtx.textAlign = 'center';
        cCtx.textBaseline = 'middle';
        cCtx.fillText(Math.ceil(gameState.shotClock).toString(), 64, 68);
        h.clockTex.needsUpdate = true;
    });

    // 2. Animated 3D Crowd Wave & Camera Flashes
    if (flashLight.intensity > 0.05) {
        flashLight.intensity *= Math.pow(0.02, dt);
    }
    gameState.crowdHype = Math.max(0.15, gameState.crowdHype - dt * 0.25);

    for (let i = 0; i < crowdInstanced.count; i++) {
        const f = crowdData[i];
        const jump = Math.max(0, Math.sin(elapsed * f.speed + f.phase)) * (0.08 + gameState.crowdHype * 0.34);
        dummy.position.set(f.x, f.baseY + jump, f.z);
        dummy.lookAt(0, f.baseY - 1, 0);
        dummy.updateMatrix();
        crowdInstanced.setMatrixAt(f.index, dummy.matrix);
    }
    crowdInstanced.instanceMatrix.needsUpdate = true;

    // 3. Jumbotron Live Score & Clock Render
    jumboCtx.fillStyle = '#070c18';
    jumboCtx.fillRect(0, 0, 512, 256);
    jumboCtx.strokeStyle = '#38bdf8';
    jumboCtx.lineWidth = 6;
    jumboCtx.strokeRect(4, 4, 504, 248);

    jumboCtx.fillStyle = '#fbbf24';
    jumboCtx.font = '800 32px Teko, sans-serif';
    jumboCtx.textAlign = 'center';
    jumboCtx.fillText(`2K26 PRO ARENA  •  Q${gameState.quarter}  •  SHOT ${Math.ceil(gameState.shotClock)}`, 256, 42);

    jumboCtx.fillStyle = '#f43f5e';
    jumboCtx.font = '900 44px Teko, sans-serif';
    jumboCtx.fillText('VISITORS', 130, 105);
    jumboCtx.fillStyle = '#ffffff';
    jumboCtx.font = '900 84px Teko, sans-serif';
    jumboCtx.fillText(gameState.awayScore.toString(), 130, 185);

    jumboCtx.fillStyle = '#38bdf8';
    jumboCtx.font = '900 44px Teko, sans-serif';
    jumboCtx.fillText('2K PROS', 382, 105);
    jumboCtx.fillStyle = '#ffffff';
    jumboCtx.font = '900 84px Teko, sans-serif';
    jumboCtx.fillText(gameState.homeScore.toString(), 382, 185);

    jumboTex.needsUpdate = true;
    updateLedRibbon(elapsed);
}

// --- 15. BROADCAST CAMERA RIGS (2K CLASSIC, TV BROADCAST, COURTSIDE, ACTION) ---
const camTargetPos = new THREE.Vector3();
const camLookAtPos = new THREE.Vector3();

function updateCamera(dt) {
    const focus = gameState.ballState === 'held' && gameState.ballHandler ? gameState.ballHandler.pos : ballMesh.position;

    if (gameState.camMode === 0) {
        // 2K Classic Baseline-Behind-Offense Angle (flips smoothly with possession or tracks right court)
        const dir = (gameState.ballHandler && gameState.ballHandler.team === 'away') ? -1 : 1;
        camTargetPos.set(focus.x - dir * 13.8, 7.2, focus.z * 0.55);
        camLookAtPos.set(focus.x + dir * 5.2, 1.35, focus.z * 0.35);
    } else if (gameState.camMode === 1) {
        // NBA on TNT / ESPN Broadcast Sideline Angle
        camTargetPos.set(focus.x * 0.62, 11.2, 19.8);
        camLookAtPos.set(focus.x * 0.72, 1.2, 0);
    } else if (gameState.camMode === 2) {
        // Courtside Low Photographer Angle
        camTargetPos.set(focus.x * 0.5, 2.35, 11.4);
        camLookAtPos.set(focus.x * 0.85, 1.65, 0);
    } else {
        // Player Lock Tight Action Cam
        const cp = gameState.controlledPlayer || gameState.players[0];
        const dir = cp.team === 'home' ? 1 : -1;
        camTargetPos.set(cp.pos.x - dir * 5.8, 3.4, cp.pos.z * 0.85);
        camLookAtPos.set(cp.pos.x + dir * 4.5, 1.5, cp.pos.z * 0.5);
    }

    camera.position.lerp(camTargetPos, Math.min(1, dt * 4.2));
    camera.lookAt(camLookAtPos);
}

// --- 16. MAIN GAME & RENDER LOOP ---
let lastTime = performance.now();

function animate(now) {
    requestAnimationFrame(animate);

    let rawDt = Math.min(0.05, (now - lastTime) / 1000);
    lastTime = now;

    // Cinematic Green-Light Slow Motion
    if (gameState.slowMoTimer > 0) {
        gameState.slowMoTimer -= rawDt;
        rawDt *= 0.42;
    }

    // Game Clock & 24s Shot Clock
    if (gameState.ballState === 'held') {
        gameState.gameClock = Math.max(0, gameState.gameClock - rawDt);
        gameState.shotClock = Math.max(0, gameState.shotClock - rawDt);

        if (gameState.shotClock <= 0) {
            sfx.playBuzzer();
            triggerCallout('SHOT CLOCK VIOLATION', 'text-rose-400', 'TURNOVER');
            const nextTeam = gameState.ballHandler && gameState.ballHandler.team === 'home' ? 'away' : 'home';
            resetPositionsForPossession(nextTeam, false);
        }
        if (gameState.gameClock <= 0) {
            sfx.playBuzzer();
            if (gameState.quarter < 4) {
                gameState.quarter++;
                gameState.gameClock = 180;
                document.getElementById('quarter-label').textContent = `${gameState.quarter}${gameState.quarter === 2 ? 'ND' : (gameState.quarter === 3 ? 'RD' : 'TH')} QTR`;
                triggerCallout(`QUARTER ${gameState.quarter}`, 'text-amber-400', 'START OF PERIOD');
            } else {
                const winText = gameState.homeScore >= gameState.awayScore ? '2K PROS WIN!' : 'VISITORS WIN!';
                triggerCallout(winText, 'text-emerald-400', `FINAL: ${gameState.homeScore} - ${gameState.awayScore}`);
                gameState.quarter = 1;
                gameState.gameClock = 180;
                gameState.homeScore = 0;
                gameState.awayScore = 0;
                document.getElementById('score-home').textContent = '0';
                document.getElementById('score-away').textContent = '0';
            }
        }
    }

    const mins = Math.floor(gameState.gameClock / 60);
    const secs = Math.floor(gameState.gameClock % 60);
    document.getElementById('game-clock').textContent = `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
    const scEl = document.getElementById('shot-clock');
    scEl.textContent = Math.ceil(gameState.shotClock);
    scEl.className = `font-sports text-xl sm:text-2xl font-bold leading-none ${gameState.shotClock <= 5 ? 'text-red-500 animate-pulse' : 'text-amber-400'}`;

    updatePlayersAndAI(rawDt);
    updateBallAndScoring(rawDt);
    updateShotMeterUI(rawDt);
    updateArenaDetails(rawDt, now * 0.001);
    updateCamera(rawDt);

    if (composer) {
        composer.render();
    } else {
        renderer.render(scene, camera);
    }
}

window.addEventListener('resize', () => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
    if (composer) {
        composer.setSize(window.innerWidth, window.innerHeight);
    }
});

window.onload = function () {
    animate(performance.now());
};
</script>
