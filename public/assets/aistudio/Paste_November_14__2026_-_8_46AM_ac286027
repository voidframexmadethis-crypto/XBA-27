// --- 7. ARTICULATED 3D BASKETBALL PLAYER RIG & PROCEDURAL ANIMATION ENGINE ---
const SKIN_TONES = [0x8d5524, 0xc68642, 0xe0ac69, 0x5c3818, 0xf1c27d];
const HOME_NAMES = ['J. STORM', 'K. BLAZE', 'A. TITAN', 'M. VIPER', 'D. ATLAS'];
const AWAY_NAMES = ['R. SHADOW', 'L. FROST', 'T. PHANTOM', 'C. REX', 'V. GOLIATH'];
const POSITIONS = ['PG', 'SG', 'SF', 'PF', 'C'];
const NUMBERS = ['1', '23', '7', '34', '15'];

function createArticulatedPlayer(team, index) {
    // team: 'home' (+1 attacks Right hoop +X) or 'away' (-1 attacks Left hoop -X)
    const root = new THREE.Group();
    const isHome = team === 'home';
    const skinColor = SKIN_TONES[(index + (isHome ? 0 : 2)) % SKIN_TONES.length];
    const primaryColor = isHome ? '#0369a1' : '#be123c';
    const trimColor = isHome ? '#fbbf24' : '#f8fafc';
    const jerseyHex = isHome ? 0x0369a1 : 0xbe123c;

    const skinMat = new THREE.MeshStandardMaterial({
        color: skinColor,
        roughness: 0.42, // Subtle arena sweat sheen
        metalness: 0.06
    });
    const jerseyTex = createJerseyTexture(NUMBERS[index], primaryColor, trimColor);
    const jerseyMat = new THREE.MeshStandardMaterial({
        map: jerseyTex,
        roughness: 0.65
    });
    const shortsMat = new THREE.MeshStandardMaterial({
        color: jerseyHex,
        roughness: 0.65
    });
    const shoeMat = new THREE.MeshStandardMaterial({
        color: isHome ? 0x38bdf8 : 0xf43f5e,
        emissive: isHome ? 0x0284c7 : 0xe11d48,
        emissiveIntensity: 0.25,
        roughness: 0.3
    });
    const sleeveMat = new THREE.MeshStandardMaterial({ color: 0x0f172a, roughness: 0.7 });

    // Height variation by position (PG 1.92m -> C 2.13m)
    const scale = 0.96 + index * 0.025;
    root.scale.setScalar(scale);

    // Pelvis / Hips pivot
    const hips = new THREE.Group();
    hips.position.y = 1.02;
    root.add(hips);

    // Shorts
    const shorts = new THREE.Mesh(new THREE.CylinderGeometry(0.16, 0.19, 0.34, 14), shortsMat);
    shorts.position.y = -0.06;
    shorts.castShadow = true;
    hips.add(shorts);

    // Torso (Jersey)
    const torso = new THREE.Mesh(new THREE.CylinderGeometry(0.20, 0.155, 0.56, 16), jerseyMat);
    torso.position.y = 0.32;
    torso.rotation.y = -Math.PI / 2; // Align front number to +Z
    torso.castShadow = true;
    hips.add(torso);

    // Head + Hair + Headband
    const headGroup = new THREE.Group();
    headGroup.position.y = 0.72;
    hips.add(headGroup);

    const head = new THREE.Mesh(new THREE.SphereGeometry(0.125, 16, 16), skinMat);
    head.scale.set(0.92, 1.08, 0.98);
    head.castShadow = true;
    headGroup.add(head);

    const hair = new THREE.Mesh(
        new THREE.SphereGeometry(0.132, 16, 12, 0, Math.PI * 2, 0, Math.PI * 0.58),
        new THREE.MeshStandardMaterial({ color: 0x111111, roughness: 0.9 })
    );
    hair.position.y = 0.015;
    headGroup.add(hair);

    if (index % 2 === 0) {
        const headband = new THREE.Mesh(
            new THREE.CylinderGeometry(0.133, 0.133, 0.04, 16, 1, true),
            new THREE.MeshStandardMaterial({ color: isHome ? 0xfbbf24 : 0xffffff, side: THREE.DoubleSide })
        );
        headband.position.y = 0.04;
        headGroup.add(headband);
    }

    // Articulated Limbs Helper
    function createLimb(upperLen, lowerLen, upperRad, lowerRad, upperMat, lowerMat, isLeg = false) {
        const hipOrShoulder = new THREE.Group();
        const upper = new THREE.Mesh(new THREE.CylinderGeometry(upperRad, upperRad * 0.85, upperLen, 12), upperMat);
        upper.position.y = -upperLen / 2;
        upper.castShadow = true;
        hipOrShoulder.add(upper);

        const joint = new THREE.Group();
        joint.position.y = -upperLen;
        hipOrShoulder.add(joint);

        const lower = new THREE.Mesh(new THREE.CylinderGeometry(lowerRad, lowerRad * 0.78, lowerLen, 12), lowerMat);
        lower.position.y = -lowerLen / 2;
        lower.castShadow = true;
        joint.add(lower);

        if (isLeg) {
            // High-top sneaker
            const shoe = new THREE.Mesh(new THREE.BoxGeometry(0.12, 0.09, 0.26), shoeMat);
            shoe.position.set(0, -lowerLen - 0.03, 0.05);
            shoe.castShadow = true;
            joint.add(shoe);
        }

        return { root: hipOrShoulder, joint };
    }

    const leftArm = createLimb(0.32, 0.30, 0.062, 0.048, skinMat, index === 0 ? sleeveMat : skinMat, false);
    leftArm.root.position.set(0.24, 0.54, 0);
    hips.add(leftArm.root);

    const rightArm = createLimb(0.32, 0.30, 0.062, 0.048, skinMat, index === 1 ? sleeveMat : skinMat, false);
    rightArm.root.position.set(-0.24, 0.54, 0);
    hips.add(rightArm.root);

    const leftLeg = createLimb(0.46, 0.46, 0.088, 0.065, skinMat, index % 3 === 0 ? sleeveMat : skinMat, true);
    leftLeg.root.position.set(0.105, -0.10, 0);
    hips.add(leftLeg.root);

    const rightLeg = createLimb(0.46, 0.46, 0.088, 0.065, skinMat, skinMat, true);
    rightLeg.root.position.set(-0.105, -0.10, 0);
    hips.add(rightLeg.root);

    // 2K Floor Selection Ring under player
    const ringGeo = new THREE.RingGeometry(0.46, 0.58, 32);
    const ringMat = new THREE.MeshBasicMaterial({
        color: isHome ? 0x38bdf8 : 0xf43f5e,
        side: THREE.DoubleSide,
        transparent: true,
        opacity: 0.0
    });
    const selectRing = new THREE.Mesh(ringGeo, ringMat);
    selectRing.rotation.x = -Math.PI / 2;
    selectRing.position.y = 0.02;
    root.add(selectRing);

    scene.add(root);

    return {
        id: `${team}_${index}`,
        team,
        index,
        name: isHome ? HOME_NAMES[index] : AWAY_NAMES[index],
        posLabel: `${POSITIONS[index]} #${NUMBERS[index]}`,
        root,
        hips,
        headGroup,
        leftArm,
        rightArm,
        leftLeg,
        rightLeg,
        selectRing,
        pos: new THREE.Vector3(),
        vel: new THREE.Vector3(),
        facing: isHome ? Math.PI / 2 : -Math.PI / 2,
        stamina: 100,
        stridePhase: Math.random() * Math.PI * 2,
        dribblePhase: 0,
        dribbleHand: 1, // 1 = right, -1 = left
        crossoverTimer: 0,
        stunTimer: 0, // Ankle-broken timer
        jumpY: 0,
        jumpVel: 0,
        isJumping: false,
        isDunking: false,
        dunkTarget: new THREE.Vector3(),
        stealCooldown: 0,
        contestValue: 0,
        active: true
    };
}

