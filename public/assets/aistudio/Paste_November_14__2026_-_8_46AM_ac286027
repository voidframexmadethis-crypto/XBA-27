const CROWD_COUNT = 3600;
const crowdGeo = new THREE.BoxGeometry(0.36, 0.72, 0.28);
const crowdMat = new THREE.MeshLambertMaterial({ color: 0xffffff });
const crowdInstanced = new THREE.InstancedMesh(crowdGeo, crowdMat, CROWD_COUNT);
const crowdData = [];
const dummy = new THREE.Object3D();
const fanColors = [
    new THREE.Color(0x0284c7), new THREE.Color(0x1d4ed8), new THREE.Color(0xf8fafc),
    new THREE.Color(0xe11d48), new THREE.Color(0xf59e0b), new THREE.Color(0x334155)
];

let cIdx = 0;
for (let tier = 0; tier < 18; tier++) {
    const y = 1.1 + tier * 0.68;
    const rx = 18.8 + tier * 0.95;
    const rz = 12.2 + tier * 0.85;
    const fansInRing = 200;
    for (let i = 0; i < fansInRing && cIdx < CROWD_COUNT; i++) {
        const angle = (i / fansInRing) * Math.PI * 2 + (tier % 2) * 0.015;
        const fx = Math.cos(angle) * rx;
        const fz = Math.sin(angle) * rz;
        // Leave aisle gaps
        if (Math.abs(fx) < 1.2 || Math.abs(fz) < 1.0) continue;

        dummy.position.set(fx, y, fz);
        dummy.lookAt(0, y - 1, 0);
        dummy.updateMatrix();
        crowdInstanced.setMatrixAt(cIdx, dummy.matrix);
        crowdInstanced.setColorAt(cIdx, fanColors[(cIdx + tier) % fanColors.length]);

        crowdData.push({
            index: cIdx,
            x: fx,
            baseY: y,
            z: fz,
            phase: Math.random() * Math.PI * 2,
            speed: 3.5 + Math.random() * 3.0
        });
