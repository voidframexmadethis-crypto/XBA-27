<script>
/**
 * ============================================================================
 * 2K26 NEXT-GEN PRO ARENA — ULTRA-REALISTIC 3D BASKETBALL ENGINE
 * Single-file WebGL PBR + Procedural Hardwood + Articulated Players + 5v5 AI
 * ============================================================================
 */

// --- 1. WEB AUDIO API PROCEDURAL ARENA SOUND ENGINE ---
class ArenaAudio {
    constructor() {
        this.enabled = true;
        this.ctx = null;
    }

    init() {
        if (!this.ctx) {
            const AudioCtx = window.AudioContext || window.webkitAudioContext;
            this.ctx = new AudioCtx();
        }
        if (this.ctx.state === 'suspended') {
            this.ctx.resume();
        }
    }

    playBounce(velocity = 1.0) {
        if (!this.enabled) return;
        this.init();
        const now = this.ctx.currentTime;
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();
        osc.type = 'sine';
        const baseFreq = 115 + Math.random() * 14;
        osc.frequency.setValueAtTime(baseFreq, now);
        osc.frequency.exponentialRampToValueAtTime(42, now + 0.14);

        const vol = Math.min(0.45, Math.max(0.06, velocity * 0.35));
        gain.gain.setValueAtTime(vol, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.16);

        osc.connect(gain);
        gain.connect(this.ctx.destination);
        osc.start(now);
        osc.stop(now + 0.17);
    }

    playSqueak() {
        if (!this.enabled || Math.random() > 0.35) return;
        this.init();
        const now = this.ctx.currentTime;
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();
        osc.type = 'triangle';
        const f1 = 2200 + Math.random() * 900;
        osc.frequency.setValueAtTime(f1, now);
        osc.frequency.exponentialRampToValueAtTime(f1 * 1.25, now + 0.04);
        osc.frequency.exponentialRampToValueAtTime(f1 * 0.85, now + 0.09);

        gain.gain.setValueAtTime(0.035, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.095);

        osc.connect(gain);
        gain.connect(this.ctx.destination);
        osc.start(now);
        osc.stop(now + 0.1);
    }

    playSwish() {
        if (!this.enabled) return;
        this.init();
        const now = this.ctx.currentTime;
        const bufferSize = this.ctx.sampleRate * 0.32;
        const buffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
        const data = buffer.getChannelData(0);
        for (let i = 0; i < bufferSize; i++) {
            data[i] = (Math.random() * 2 - 1) * Math.sin((i / bufferSize) * Math.PI);
        }
        const noise = this.ctx.createBufferSource();
        noise.buffer = buffer;

        const filter = this.ctx.createBiquadFilter();
        filter.type = 'bandpass';
        filter.frequency.setValueAtTime(2400, now);
        filter.frequency.exponentialRampToValueAtTime(950, now + 0.3);
        filter.Q.value = 1.6;

        const gain = this.ctx.createGain();
        gain.gain.setValueAtTime(0.45, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.32);

        noise.connect(filter);
        filter.connect(gain);
        gain.connect(this.ctx.destination);
        noise.start(now);
    }

    playRimClank() {
        if (!this.enabled) return;
        this.init();
        const now = this.ctx.currentTime;
        [320, 485, 790].forEach((freq, idx) => {
            const osc = this.ctx.createOscillator();
            const gain = this.ctx.createGain();
            osc.type = idx === 0 ? 'triangle' : 'sine';
            osc.frequency.setValueAtTime(freq, now);
            osc.frequency.exponentialRampToValueAtTime(freq * 0.72, now + 0.22);
            gain.gain.setValueAtTime(0.18 / (idx + 1), now);
            gain.gain.exponentialRampToValueAtTime(0.001, now + 0.24);
            osc.connect(gain);
            gain.connect(this.ctx.destination);
            osc.start(now);
            osc.stop(now + 0.25);
        });
    }

    playGreenRelease() {
        if (!this.enabled) return;
        this.init();
        const now = this.ctx.currentTime;
        [587.33, 880, 1174.66].forEach((freq, idx) => {
            const osc = this.ctx.createOscillator();
            const gain = this.ctx.createGain();
            osc.type = 'sine';
            osc.frequency.setValueAtTime(freq, now + idx * 0.045);
            gain.gain.setValueAtTime(0.16, now + idx * 0.045);
            gain.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.045 + 0.35);
            osc.connect(gain);
            gain.connect(this.ctx.destination);
            osc.start(now + idx * 0.045);
            osc.stop(now + idx * 0.045 + 0.36);
        });
    }

    playCrowdRoar(intensity = 1.0) {
        if (!this.enabled) return;
        this.init();
        const now = this.ctx.currentTime;
        const duration = 1.6;
        const bufferSize = this.ctx.sampleRate * duration;
        const buffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
        const data = buffer.getChannelData(0);
        for (let i = 0; i < bufferSize; i++) {
            const env = Math.pow(Math.sin((i / bufferSize) * Math.PI), 0.7);
            data[i] = (Math.random() * 2 - 1) * env;
        }
        const noise = this.ctx.createBufferSource();
        noise.buffer = buffer;

        const filter = this.ctx.createBiquadFilter();
        filter.type = 'lowpass';
        filter.frequency.setValueAtTime(650, now);
        filter.frequency.linearRampToValueAtTime(1350, now + 0.4);
        filter.frequency.linearRampToValueAtTime(520, now + duration);

        const gain = this.ctx.createGain();
        gain.gain.setValueAtTime(0.28 * intensity, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + duration);

        noise.connect(filter);
        filter.connect(gain);
        gain.connect(this.ctx.destination);
        noise.start(now);
    }

    playBuzzer() {
        if (!this.enabled) return;
        this.init();
        const now = this.ctx.currentTime;
        [110, 146.8].forEach(freq => {
            const osc = this.ctx.createOscillator();
            const gain = this.ctx.createGain();
            osc.type = 'sawtooth';
            osc.frequency.setValueAtTime(freq, now);
            gain.gain.setValueAtTime(0.22, now);
            gain.gain.exponentialRampToValueAtTime(0.001, now + 0.85);
            osc.connect(gain);
            gain.connect(this.ctx.destination);
            osc.start(now);
            osc.stop(now + 0.88);
        });
    }
}

const sfx = new ArenaAudio();

// --- 2. PROCEDURAL HIGH-RES TEXTURE GENERATORS (NBA HARDWOOD, NORMAL, ROUGHNESS, LED) ---
function createHardwoodTextures() {
    const width = 2048;
    const height = 1024;

    const colorCanvas = document.createElement('canvas');
    colorCanvas.width = width;
    colorCanvas.height = height;
    const ctx = colorCanvas.getContext('2d');

    const roughCanvas = document.createElement('canvas');
    roughCanvas.width = width;
    roughCanvas.height = height;
    const rCtx = roughCanvas.getContext('2d');

    const bumpCanvas = document.createElement('canvas');
    bumpCanvas.width = width;
    bumpCanvas.height = height;
    const bCtx = bumpCanvas.getContext('2d');

    // 1. Maple Hardwood Planks (Staggered boards across the 94ft x 50ft court)
    const rows = 56;
    const plankH = height / rows;
    for (let r = 0; r < rows; r++) {
        let xCursor = -(r % 4) * 95;
        while (xCursor < width) {
            const plankW = 140 + ((r * 37 + Math.floor(xCursor)) % 110);
            const tone = ((r * 19 + Math.floor(xCursor * 0.1)) % 24) - 12;
            const baseR = 206 + tone;
            const baseG = 152 + Math.floor(tone * 0.8);
            const baseB = 92 + Math.floor(tone * 0.5);

            ctx.fillStyle = `rgb(${baseR}, ${baseG}, ${baseB})`;
            ctx.fillRect(xCursor, r * plankH, plankW, plankH);

            // Subtle wood grain streaks inside plank
            ctx.fillStyle = `rgba(120, 72, 30, 0.08)`;
            for (let g = 0; g < 3; g++) {
                const gy = r * plankH + (g + 0.5) * (plankH / 3);
                ctx.fillRect(xCursor + 4, gy, plankW - 8, 1.2);
            }

            // Plank seam
            ctx.strokeStyle = 'rgba(85, 48, 18, 0.32)';
            ctx.lineWidth = 1;
            ctx.strokeRect(xCursor, r * plankH, plankW, plankH);

            // Roughness variation per plank (glossy clearcoat with subtle grain)
            const roughVal = 36 + ((r + Math.floor(xCursor)) % 22);
            rCtx.fillStyle = `rgb(${roughVal},${roughVal},${roughVal})`;
            rCtx.fillRect(xCursor, r * plankH, plankW, plankH);

            // Bump seam
            bCtx.fillStyle = '#888888';
            bCtx.fillRect(xCursor, r * plankH, plankW, plankH);
            bCtx.strokeStyle = '#333333';
            bCtx.lineWidth = 1.5;
            bCtx.strokeRect(xCursor, r * plankH, plankW, plankH);

            xCursor += plankW;
        }
    }

    // Court coordinate mapping: 94ft (28.65m) length x 50ft (15.24m) width
    // Plus 4ft apron around perimeter -> total mesh 31.2m x 17.8m
    const padX = width * (1.275 / 31.2);
    const padY = height * (1.28 / 17.8);
    const courtW = width - padX * 2;
    const courtH = height - padY * 2;
    const ftToPxX = courtW / 94;
    const ftToPxY = courtH / 50;

    // 2. Dark Navy / Obsidian Out-of-Bounds Apron
    ctx.fillStyle = '#0b1324';
    ctx.fillRect(0, 0, width, padY);
    ctx.fillRect(0, height - padY, width, padY);
    ctx.fillRect(0, 0, padX, height);
    ctx.fillRect(width - padX, 0, padX, height);

    // Apron matte roughness
    rCtx.fillStyle = 'rgb(115, 115, 115)';
    rCtx.fillRect(0, 0, width, padY);
    rCtx.fillRect(0, height - padY, width, padY);
    rCtx.fillRect(0, 0, padX, height);
    rCtx.fillRect(width - padX, 0, padX, height);

    // 3. Painted Keys / Lanes (Deep Royal Blue with Gold Trim)
    const keyLen = 19 * ftToPxX;
    const keyWid = 16 * ftToPxY;
    const keyTop = padY + (courtH - keyWid) / 2;

    ctx.fillStyle = 'rgba(14, 58, 128, 0.92)';
    ctx.fillRect(padX, keyTop, keyLen, keyWid);
    ctx.fillRect(width - padX - keyLen, keyTop, keyLen, keyWid);

    // 4. Center Court Holographic / Metallic "2K PRO ARENA" Emblem
    const cx = width / 2;
    const cy = height / 2;
    ctx.save();
    ctx.translate(cx, cy);

    // Outer metallic ring
    const grad = ctx.createLinearGradient(-150, -150, 150, 150);
    grad.addColorStop(0, '#0284c7');
    grad.addColorStop(0.5, '#f59e0b');
    grad.addColorStop(1, '#1d4ed8');
    ctx.beginPath();
    ctx.arc(0, 0, 6.5 * ftToPxY, 0, Math.PI * 2);
    ctx.fillStyle = 'rgba(10, 20, 42, 0.92)';
    ctx.fill();
    ctx.lineWidth = 8;
    ctx.strokeStyle = grad;
    ctx.stroke();

    // Inner basketball seam lines on logo
    ctx.beginPath();
    ctx.arc(0, 0, 5.2 * ftToPxY, 0, Math.PI * 2);
    ctx.lineWidth = 2.5;
    ctx.strokeStyle = 'rgba(245, 158, 11, 0.55)';
    ctx.stroke();

    // Crisp Logo Typography
    ctx.fillStyle = '#ffffff';
    ctx.font = '900 76px Inter, sans-serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText('2K', 0, -14);

    ctx.fillStyle = '#fbbf24';
    ctx.font = '800 24px Inter, sans-serif';
    ctx.fillText('PRO ARENA', 0, 34);
    ctx.restore();

    // 5. Crisp White & Gold NBA Court Lines
    ctx.strokeStyle = '#f8fafc';
    ctx.lineWidth = 4.5;

    // Outer boundary
    ctx.strokeRect(padX, padY, courtW, courtH);

    // Half-court line
    ctx.beginPath();
    ctx.moveTo(cx, padY);
    ctx.lineTo(cx, height - padY);
    ctx.stroke();

    // Center jump circle
    ctx.beginPath();
    ctx.arc(cx, cy, 6 * ftToPxY, 0, Math.PI * 2);
    ctx.stroke();

    // Left & Right Keys, Free Throw Circles, Restricted Areas & 3-Point Arcs
    [1, -1].forEach(dir => {
        const baseX = dir === 1 ? padX : width - padX;
        const hoopX = baseX + dir * (5.25 * ftToPxX);
        const ftX = baseX + dir * keyLen;

        // Key outline
        ctx.strokeStyle = '#fbbf24';
        ctx.lineWidth = 4;
        ctx.strokeRect(dir === 1 ? baseX : ftX, keyTop, keyLen, keyWid);

        // Free throw circle
        ctx.strokeStyle = '#f8fafc';
        ctx.beginPath();
        ctx.arc(ftX, cy, 6 * ftToPxY, 0, Math.PI * 2);
        ctx.stroke();

        // Restricted area arc (4ft radius from hoop center)
        ctx.beginPath();
        ctx.arc(hoopX, cy, 4 * ftToPxY, dir === 1 ? -Math.PI / 2 : Math.PI / 2, dir === 1 ? Math.PI / 2 : -Math.PI / 2);
        ctx.stroke();

        // NBA 3-Point Line (23.75ft arc + 22ft corner straight lines)
        const cornerDist = 3 * ftToPxY;
        const cornerLen = 14 * ftToPxX;
        const r3 = 23.75 * ftToPxY;
        const angle = Math.asin((courtH / 2 - cornerDist) / r3);

        ctx.lineWidth = 4.5;
        ctx.beginPath();
        if (dir === 1) {
            ctx.moveTo(baseX, padY + cornerDist);
            ctx.lineTo(baseX + cornerLen, padY + cornerDist);
            ctx.arc(hoopX, cy, r3, -angle, angle);
            ctx.lineTo(baseX, height - padY - cornerDist);
        } else {
            ctx.moveTo(baseX, padY + cornerDist);
            ctx.lineTo(baseX - cornerLen, padY + cornerDist);
            ctx.arc(hoopX, cy, r3, Math.PI + angle, Math.PI - angle, true);
            ctx.lineTo(baseX, height - padY - cornerDist);
        }
        ctx.stroke();

        // Lane hash marks
        [7, 8, 11, 14].forEach(distFt => {
            const hx = baseX + dir * (distFt * ftToPxX);
            ctx.beginPath();
            ctx.moveTo(hx, keyTop - 10);
            ctx.lineTo(hx, keyTop);
            ctx.moveTo(hx, keyTop + keyWid);
            ctx.lineTo(hx, keyTop + keyWid + 10);
            ctx.stroke();
        });
    });

    // Baseline Team Wordmarks
    ctx.save();
    ctx.fillStyle = '#38bdf8';
    ctx.font = '900 34px Inter, sans-serif';
    ctx.textAlign = 'center';
    ctx.translate(padX * 0.5, cy);
    ctx.rotate(-Math.PI / 2);
    ctx.fillText('2K PROS BASKETBALL', 0, 6);
    ctx.restore();

    ctx.save();
    ctx.fillStyle = '#f43f5e';
    ctx.font = '900 34px Inter, sans-serif';
    ctx.textAlign = 'center';
    ctx.translate(width - padX * 0.5, cy);
    ctx.rotate(Math.PI / 2);
    ctx.fillText('NEXT-GEN ARENA', 0, 6);
    ctx.restore();

    const colorTex = new THREE.CanvasTexture(colorCanvas);
    colorTex.anisotropy = 16;
    const roughTex = new THREE.CanvasTexture(roughCanvas);
    const bumpTex = new THREE.CanvasTexture(bumpCanvas);

    return { colorTex, roughTex, bumpTex };
}

function createBasketballTexture() {
    const canvas = document.createElement('canvas');
    canvas.width = 512;
    canvas.height = 256;
    const ctx = canvas.getContext('2d');

    ctx.fillStyle = '#d95b16';
    ctx.fillRect(0, 0, 512, 256);

    // Pebble grain noise
    for (let i = 0; i < 6500; i++) {
        ctx.fillStyle = i % 2 === 0 ? 'rgba(0,0,0,0.14)' : 'rgba(255,190,130,0.12)';
        ctx.fillRect(Math.random() * 512, Math.random() * 256, 2, 2);
    }

    // Black leather ribs
    ctx.strokeStyle = '#18181b';
    ctx.lineWidth = 5;
    ctx.beginPath();
    ctx.moveTo(0, 128);
    ctx.lineTo(512, 128);
    ctx.moveTo(128, 0);
    ctx.lineTo(128, 256);
    ctx.moveTo(384, 0);
    ctx.lineTo(384, 256);
    ctx.stroke();

    ctx.beginPath();
    ctx.arc(128, 128, 92, -Math.PI / 2, Math.PI / 2);
    ctx.stroke();
    ctx.beginPath();
    ctx.arc(384, 128, 92, Math.PI / 2, -Math.PI / 2);
    ctx.stroke();

    return new THREE.CanvasTexture(canvas);
}

function createJerseyTexture(numberText, primaryHex, trimHex) {
    const canvas = document.createElement('canvas');
    canvas.width = 256;
    canvas.height = 256;
    const ctx = canvas.getContext('2d');

    ctx.fillStyle = primaryHex;
    ctx.fillRect(0, 0, 256, 256);

    // Subtle athletic mesh pattern
    ctx.fillStyle = 'rgba(0,0,0,0.08)';
    for (let y = 0; y < 256; y += 4) {
        for (let x = 0; x < 256; x += 4) {
            ctx.fillRect(x, y, 2, 2);
        }
    }

    // Side stripes
    ctx.fillStyle = trimHex;
    ctx.fillRect(0, 0, 18, 256);
    ctx.fillRect(238, 0, 18, 256);
    ctx.fillRect(119, 0, 18, 256);

    // Front Number (around x = 64) & Back Number (around x = 192)
    ctx.fillStyle = '#ffffff';
    ctx.strokeStyle = trimHex;
    ctx.lineWidth = 4;
    ctx.font = '900 68px Teko, Inter, sans-serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';

    ctx.strokeText(numberText, 64, 130);
    ctx.fillText(numberText, 64, 130);

    ctx.strokeText(numberText, 192, 130);
    ctx.fillText(numberText, 192, 130);

    // Team wordmark above front number
    ctx.font = '700 20px Inter, sans-serif';
    ctx.fillText('2K PRO', 64, 72);

    return new THREE.CanvasTexture(canvas);
}

