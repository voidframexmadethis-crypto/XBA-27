function applyGameModeRoster() {
    const activeCount = gameState.mode === '5v5' ? 5 : (gameState.mode === '3v3' ? 3 : 1);
    gameState.players.forEach(p => {
        p.active = p.index < activeCount;
        p.root.visible = p.active;
    });
    if (!gameState.controlledPlayer || !gameState.controlledPlayer.active) {
        gameState.controlledPlayer = gameState.players.find(p => p.team === 'home' && p.active);
    }
}

function resetPositionsForPossession(offenseTeam, isTipoff = false) {
    applyGameModeRoster();
    const dir = offenseTeam === 'home' ? 1 : -1;
    const activeOff = gameState.players.filter(p => p.team === offenseTeam && p.active);
    const activeDef = gameState.players.filter(p => p.team !== offenseTeam && p.active);

    const offOffsets = [
        [dir * 2.2, 0],
        [dir * 6.5, -5.2],
        [dir * 6.5, 5.2],
        [dir * 10.2, -3.4],
        [dir * 10.2, 3.4]
    ];

    activeOff.forEach((p, idx) => {
        const [ox, oz] = offOffsets[idx];
        p.pos.set(isTipoff ? -dir * 2.0 : ox, 0, oz);
        p.vel.set(0, 0, 0);
        p.jumpY = 0;
        p.isJumping = false;
        p.isDunking = false;
        p.stunTimer = 0;
        p.facing = dir === 1 ? Math.PI / 2 : -Math.PI / 2;
    });

    activeDef.forEach((p, idx) => {
        const match = activeOff[idx] || activeOff[0];
        p.pos.set(match.pos.x + dir * 2.1, 0, match.pos.z * 0.85);
        p.vel.set(0, 0, 0);
        p.jumpY = 0;
        p.isJumping = false;
        p.isDunking = false;
        p.stunTimer = 0;
        p.facing = dir === 1 ? -Math.PI / 2 : Math.PI / 2;
    });

    const pg = activeOff[0];
    gameState.ballHandler = pg;
    gameState.ballState = 'held';
    gameState.shotClock = 24;
    if (offenseTeam === 'home') {
        gameState.controlledPlayer = pg;
    } else {
        gameState.controlledPlayer = activeDef[0];
    }
    updateHudLabels();
}

