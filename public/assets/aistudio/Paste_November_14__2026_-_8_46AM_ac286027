        #canvas-container { position: fixed; inset: 0; z-index: 1; }
        canvas { display: block; width: 100%; height: 100%; }
        .font-sports { font-family: 'Teko', sans-serif; letter-spacing: 0.04em; }

        /* Broadcast Scorebug & Glassmorphic HUD */
        .broadcast-panel {
            background: linear-gradient(135deg, rgba(12, 16, 26, 0.88), rgba(20, 27, 45, 0.82));
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.14);
            box-shadow: 0 12px 36px rgba(0, 0, 0, 0.65);
        }
        .scorebug-skew {
            transform: skewX(-10deg);
        }
        .scorebug-unskew {
            transform: skewX(10deg);
        }

        /* Green Light / Callout Animations */
        @keyframes popFlash {
            0% { transform: scale(0.5) translateY(20px); opacity: 0; filter: brightness(2); }
            20% { transform: scale(1.12) translateY(0); opacity: 1; filter: brightness(1.3); }
            80% { transform: scale(1.0) translateY(-4px); opacity: 1; filter: brightness(1); }
            100% { transform: scale(0.95) translateY(-18px); opacity: 0; }
        }
        .callout-anim {
            animation: popFlash 1.65s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        /* Touch Controls Styling */
        .action-btn {
            background: radial-gradient(circle at 30% 30%, rgba(255,255,255,0.22), rgba(15,23,42,0.85));
            border: 2px solid rgba(255,255,255,0.28);
